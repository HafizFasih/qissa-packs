{
 "format": 1,
 "id": "everyday-scenes",
 "name": "Everyday scenes",
 "version": "1.0.0",
 "author": "Qissa Studio",
 "category": "scenes",
 "license": "CC0 1.0 (see LICENSE.txt)",
 "description": "Eight ready scenes to drop into a reel: a family iftar, a lesson in the masjid, walking to Fajr, Eid morning, kindness to a cat, a desert journey, the days of Mina and visiting grandparents.",
 "requires": [
  "family-elders",
  "everyday-moves",
  "places",
  "animals",
  "ramadan-eid",
  "hajj-umrah"
 ],
 "presets": [
  {
   "id": "family-iftar",
   "name": "Family iftar",
   "description": "The family sits around the iftar cloth; the father eats, the girl claps",
   "scene": {
    "kind": "canvas",
    "duration": 6,
    "background": {
     "type": "living_room"
    },
    "elements": [
     {
      "type": "text",
      "role": "title",
      "text": "Iftar together",
      "x": 540,
      "y": 380
     },
     {
      "type": "prop",
      "prop": "ramadan-eid/iftar-spread",
      "x": 540,
      "y": 1500,
      "size": 190,
      "color": "#f4efe6",
      "color2": "#b5523a"
     },
     {
      "type": "figure",
      "figure": "family-elders/father",
      "x": 250,
      "y": 1490,
      "height": 400,
      "pose": "sit_floor",
      "cycle": {
       "poses": "everyday-moves/eating-seated",
       "from": 1.5
      }
     },
     {
      "type": "figure",
      "figure": "family-elders/mother",
      "x": 830,
      "y": 1490,
      "height": 400,
      "pose": "sit_floor",
      "facing": "left"
     },
     {
      "type": "figure",
      "figure": "family-elders/girl",
      "x": 700,
      "y": 1530,
      "height": 400,
      "pose": "sit_floor",
      "facing": "left",
      "cycle": {
       "poses": "everyday-moves/clap",
       "from": 3
      }
     }
    ]
   }
  },
  {
   "id": "masjid-lesson",
