      "y": 1480,
      "size": 110,
      "color": "#f4efe6",
      "color2": "#2f6b4f"
     },
     {
      "type": "figure",
      "figure": "family-elders/student",
      "x": 680,
      "y": 1480,
      "height": 400,
      "pose": "sit_floor",
      "facing": "left",
      "cycle": {
       "poses": "everyday-moves/deep-thought",
       "from": 2
      }
     },
     {
      "type": "figure",
      "figure": "family-elders/boy",
      "x": 860,
      "y": 1500,
      "height": 400,
      "pose": "sit_floor",
      "facing": "left"
     }
    ]
   }
  },
  {
   "id": "walk-to-fajr",
   "name": "Walking to Fajr",
   "description": "A father and his son walk to the masjid before dawn",
